{
  "name": "TEKTON Elevators",
  "short_name": "TEKTON",
  "description": "Official TEKTON Elevators site lead collection, survey entry, and operational status management app.",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "./index.html",
  "id": "tekton-elevators-pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "tabbed",
    "standalone",
    "window-controls-overlay"
  ],
  "background_color": "#0A1A3A",
  "theme_color": "#0A1A3A",
  "orientation": "portrait",
  "categories": [
    "business",
    "utilities"
  ],
  "prefer_related_applications": true,
  "related_applications": [
    {
      "platform": "play",
      "id": "com.tekton.elevators",
      "url": "https://play.google.com/store/apps/details?id=com.tekton.elevators"
    }
  ],
  "iarc_rating_id": "e58c1706-613d-4217-0000-000000000000",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "wide",
      "label": "TEKTON Elevators Desktop Overview"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "TEKTON Elevators Mobile Overview"
    }
  ],
  "shortcuts": [
    {
      "name": "New Site Survey",
      "short_name": "New Survey",
      "description": "Capture new elevator site lead and GPS data",
      "url": "./index.html",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "View Enquiries",
      "short_name": "Enquiries",
      "description": "Check current site lead status and pipeline",
      "url": "./index.html",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "./index.html",
      "name": "TEKTON Lead Data File",
      "accept": {
        "application/json": [".json"],
        "text/csv": [".csv"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+tekton",
      "url": "./index.html?lead=%s"
    }
  ],
  "widgets": [
    {
      "name": "TEKTON Stats",
      "short_name": "TEKTON",
      "description": "Overview of TEKTON leads",
      "tag": "tekton-widget",
      "template": "widgets/tekton-template.json",
      "type": "application/json",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "note_taking": {
    "new_note_url": "./index.html"
  },
  "scope_extensions": [
    {
      "origin": "tekvp.github.io"
    },
    {
      "origin": "*.github.io"
    }
  ]
}
