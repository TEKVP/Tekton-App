{
  "name": "TEKTON Elevators",
  "short_name": "TEKTON",
  "description": "Official TEKTON Elevators site lead collection, survey entry, and operational status management app.",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "./index.html",
  "id": "tekton-elevators-pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "window-controls-overlay",
    "minimal-ui"
  ],
  "background_color": "#0A1A3A",
  "theme_color": "#0A1A3A",
  "orientation": "portrait",
  "categories": [
    "business",
    "utilities"
  ],
  "prefer_related_applications": false,
  "related_applications": [],
  "iarc_rating_id": "e58c1706-613d-4217-0000-000000000000",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "logo.png",
      "sizes": "900x207",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "logo.png",
      "sizes": "900x207",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "logo.png",
      "sizes": "900x207",
      "type": "image/png",
      "form_factor": "wide",
      "label": "TEKTON Elevators Executive Dashboard"
    },
    {
      "src": "logo.png",
      "sizes": "900x207",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "TEKTON Elevators Mobile App Interface"
    }
  ],
  "shortcuts": [
    {
      "name": "New Site Survey",
      "short_name": "New Survey",
      "description": "Capture new elevator site lead and GPS data",
      "url": "./index.html",
      "icons": [
        {
          "src": "logo.png",
          "sizes": "900x207",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "View Enquiries",
      "short_name": "Enquiries",
      "description": "Check current site lead status and pipeline",
      "url": "./index.html",
      "icons": [
        {
          "src": "logo.png",
          "sizes": "900x207",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "./index.html",
      "name": "TEKTON Lead Data File",
      "accept": {
        "application/json": [".json"],
        "text/csv": [".csv"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+tekton",
      "url": "./index.html?lead=%s"
    }
  ],
  "widgets": [
    {
      "name": "TEKTON Quick Stats",
      "short_name": "TEKTON Stats",
      "description": "Overview of TEKTON Lead Status",
      "tag": "tekton-stats-widget",
      "template": "tekton-stats-template",
      "ms_ac_template": "widgets/tekton-stats.json",
      "data": "widgets/tekton-stats-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "logo.png",
          "sizes": "900x207",
          "label": "Widget Preview"
        }
      ],
      "icons": [
        {
          "src": "logo.png",
          "sizes": "900x207"
        }
      ]
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "note_taking": {
    "new_note_url": "./index.html"
  },
  "scope_extensions": [
    {
      "origin": "tekvp.github.io"
    }
  ]
}
